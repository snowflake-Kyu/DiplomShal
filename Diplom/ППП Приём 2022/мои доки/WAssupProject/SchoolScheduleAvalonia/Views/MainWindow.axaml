<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SchoolScheduleAvalonia.Views.MainWindow"
        Width="1220"
        Height="760"
        MinWidth="1040"
        MinHeight="640"
        Title="{Binding WindowTitle}">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="2.1*,0.9*" Background="#F4F6FA">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#263238" Padding="18">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
          <TextBlock Text="Управление расписанием" FontSize="24" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Avalonia UI клиент к ASP.NET Web API" Foreground="#CFD8DC" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBox Width="300"
                   Watermark="Поиск: дата, класс, дисциплина, преподаватель"
                   Text="{Binding SearchText, Mode=TwoWay}" />
          <Button Content="Обновить" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                   Text="{Binding StatusMessage}"
                   Foreground="#ECEFF1"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Margin="14" Background="White" CornerRadius="10" BorderBrush="#D7DCE2" BorderThickness="1">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#EEF2F6" Padding="12" CornerRadius="10,10,0,0">
          <Grid ColumnDefinitions="70,110,140,210,170,130,240">
            <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Дата" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Класс" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Дисциплина" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="Преподаватель" FontWeight="SemiBold" />
            <TextBlock Grid.Column="5" Text="Время" FontWeight="SemiBold" />
            <TextBlock Grid.Column="6" Text="Назначение" FontWeight="SemiBold" />
          </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ScheduleRows}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 Padding="0"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="12" BorderBrush="#EDF0F3" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="70,110,140,210,170,130,240">
                  <TextBlock Grid.Column="0" Text="{Binding ScheduleId}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding DateText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding ClassName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding DisciplineName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding TeacherName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="{Binding TimeSlotText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="6" Text="{Binding AssignmentText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Margin="0,14,14,14" Background="White" CornerRadius="10" BorderBrush="#D7DCE2" BorderThickness="1" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding FormModeText}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Выбери запись слева для редактирования или очисти форму для создания новой записи." TextWrapping="Wrap" Foreground="#546E7A" />

          <StackPanel Spacing="5">
            <TextBlock Text="Дата" FontWeight="SemiBold" />
            <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="Класс" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding ClassOptions}"
                      SelectedItem="{Binding SelectedClass, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="Дисциплина" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding DisciplineOptions}"
                      SelectedItem="{Binding SelectedDiscipline, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="Время" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding TimeSlotOptions}"
                      SelectedItem="{Binding SelectedTimeSlot, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="Назначение преподавателя" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding AssignmentOptions}"
                      SelectedItem="{Binding SelectedAssignment, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <Border Background="#F6F8FA" Padding="12" CornerRadius="8" Margin="0,8,0,0">
            <StackPanel Spacing="2">
              <TextBlock Text="API" FontWeight="SemiBold" Foreground="#455A64" />
              <TextBlock Text="{Binding ApiBaseUrl}" TextWrapping="Wrap" Foreground="#455A64" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" />
            <Button Content="Удалить" Command="{Binding DeleteCommand}" />
            <Button Content="Очистить" Command="{Binding ClearFormCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
